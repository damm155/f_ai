# Built outputs
.gradle/
build/
app/build/

# IDE
.idea/
*.iml

# Local config
local.properties

# Signing (release keystore + passwords — never commit)
*.jks
*.keystore
keystore.properties
# 例外：逆向能力随 APK 分发的 patch 证书（PKCS12，口令硬编码在 ApkSignTool），
# 不是发布签名私钥；被 *.keystore 误伤会导致 apkSign 工具运行期取不到证书。
!app/src/main/assets/reverse/keystore/patch.keystore

# Debug / profiling
*.hprof

# Claude
.claude/
/.kotlin/
/.agents/
/.aicode/

# 临时调试文件
/*.log
log-*.txt
*.apk
/test

# Python（模型数据更新脚本）
__pycache__/
*.pyc