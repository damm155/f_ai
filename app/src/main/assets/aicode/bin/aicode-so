#!/bin/sh
# 逆向：原生 SO 工具链（ELF 摘要 / 符号 / JNI 动态注册 / 反汇编 / 字符串）、以及打补丁。
# 移植自 FBox（资产由 ReverseAssets 按需解压到 /root/so-tool）。
#
# 与 FBox 的 so_* 工具一一对应：
#   aicode-so info    <so>                 ← so_info     （架构/位数/PIE/NX/RELRO/节区/DT_NEEDED）
#   aicode-so symbols <so> [正则]          ← so_symbols  （函数符号表；Java_ 开头的 JNI 自动标注）
#   aicode-so jni     <so>                 ← so_jni      （RegisterNatives 动态注册三方组还原）
#   aicode-so disasm  <so> <地址或符号> [字节数]  ← so_disasm
#   aicode-so strings <so> [正则]          ← so_strings
#   aicode-so cfg     <so> <地址或符号>     ← 控制流图
#
#   补丁柜（持久 /root/patches/，patch 写入时自动记录）：
#     aicode-so patch-list [so名] / patch-read <id> / patch-status <id> <active|broken|superseded|failed> [备注]
#     aicode-so patch-rollback <id|all> / patch-delete <id>
#   知识库（持久 /root/knowledge/）：
#     aicode-so exp-save "<摘要>" [详情] [关键词] [apk] [任务] [success|failed] [1-5]
#     aicode-so exp-query [关键词...]
#
#   patch_so（完整版，asm/hex 双模式 + 分支重定位 + .bak 备份）：
#     python3 /root/flutter-re/patch_so.py <so> <addr> "asm 指令; 分号续"   ← patch_so（asm 模式）
#     python3 /root/flutter-re/patch_so.py <so> <addr> --bytes "20 00 80 52" ← patch_so（hex 模式）
#     可加 --out <路径> 另存；同路径写入自动留 <so>.bak 备份
#   aicode-so patch <so> <addr:hex>[:addr:hex...] [--dry]  ← 轻量 hex 补丁（so_tool 内置；.orig 备份）
#   aicode-so patch <so> --restore                          ← 从 .orig 还原
#
# 反汇编示例：aicode-so disasm libapp.so 0x1a2b3c 64
# 打补丁示例（asm，推荐）：python3 /root/flutter-re/patch_so.py libapp.so 0x1a2b3c "mov w0, #1; ret"
# 打补丁示例（hex）：     aicode-so patch libapp.so 0x1a2b3c:20008052c0035fd6
# 分支示例：             python3 /root/flutter-re/patch_so.py libapp.so 0x1a2b3c "b #0x1a2c0"
#   （分支目标自动按 PC 重定位；arm64 指令须 4 字节对齐）
# 移植自 FBox（资产由 ReverseAssets 按需解压到 /root/so-tool）。
# 依赖自检：so_tool 需要 python3 + capstone（Debian 镜像已预装 capstone 5.0.7）
command -v python3 >/dev/null 2>&1 || {
    echo "✗ 容器内没有 python3。逆向工具链需要 Debian 镜像（内置 debian-rootfs.bin）。" >&2
    echo "  Alpine 下需：apk add python3 py3-capstone" >&2
    exit 127
}
python3 -c "import capstone" 2>/dev/null || {
    echo "✗ python3 缺 capstone 模块（so_* 反汇编依赖）。" >&2
    echo "  Debian：apt-get install -y python3-capstone    Alpine：apk add py3-capstone" >&2
    exit 126
}
exec python3 /root/so-tool/so_tool.py "$@"
